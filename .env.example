# Uber Developer credentials (server-only; never prefix with VITE_)
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# Must match the callback URL configured in Uber Developer Dashboard.
UBER_REDIRECT_URI=https://talleria-flota.vercel.app/api/uber/callback
UBER_SCOPES=partner.accounts partner.payments partner.trips

# Optional: pre-generated bearer token for controlled server-side diagnostics.
# Prefer the OAuth connection flow instead of setting this value.
UBER_ACCESS_TOKEN=

# Server-only document analysis. Never prefix this with VITE_ or render it in the browser.
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-4.1-mini
# Consulta de costes: clave de administración restringida a api.usage.read.
# No usar OPENAI_API_KEY ni prefijo VITE_. Sin proyecto, muestra toda la organización.
OPENAI_USAGE_ADMIN_KEY=
OPENAI_USAGE_PROJECT_ID=

# Supabase browser connection. These are publishable values protected by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Consumos (solo servidor, nunca usar prefijo VITE_ para los tokens).
# La API de Vercel devuelve cargos de todo el equipo; Supabase devuelve peticiones API del proyecto.
VERCEL_USAGE_TOKEN=
VERCEL_USAGE_TEAM_ID=team_ad7etUey7ZhrGWBGgfkiu1fv
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=mrureuqfzdxyfftghifc

# Web Push. The public key is exposed to the browser; the private key and
# webhook secret stay only in Vercel environment variables and Supabase Vault.
VITE_WEB_PUSH_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:flota@sobreruedas.es
SOBRE_RUEDAS_PUSH_WEBHOOK_SECRET=
