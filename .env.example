# Uber Developer credentials (server-only; never prefix with VITE_)
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# Must match the callback URL configured in Uber Developer Dashboard.
UBER_REDIRECT_URI=https://talleria-flota.vercel.app/api/uber/callback
UBER_SCOPES=partner.accounts partner.payments partner.trips

# Optional: pre-generated bearer token for controlled server-side diagnostics.
# Prefer the OAuth connection flow instead of setting this value.
UBER_ACCESS_TOKEN=
